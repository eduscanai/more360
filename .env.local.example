# Postgres local. Em dev local no Mac com Homebrew (auth "trust", sem senha
# configurada), o usuário é o seu usuário do sistema operacional — troque
# "seu_usuario" abaixo pelo resultado de `whoami`. Em outros setups (Linux,
# Postgres com senha, Docker), ajuste todo o formato da URL.
DATABASE_URL=postgresql://seu_usuario@127.0.0.1:5432/more360_lite

# Segredo usado para assinar os JWTs de sessão e os tokens de redefinição de senha.
# Gere um novo com: openssl rand -base64 48
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-longo

# URL pública do app (usada para montar o link de "esqueci minha senha")
NEXT_PUBLIC_APP_URL=http://localhost:3010
